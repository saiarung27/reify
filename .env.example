# Reify configuration. Copy to .env and fill in.

# Storage location (default: ~/.reify)
# REIFY_HOME=~/.reify

# LLM providers (configure at least one)
# OpenAI
# OPENAI_API_KEY=sk-...
# REIFY_LLM_EXTRACT=openai:gpt-5-mini
# REIFY_LLM_RECONSOLIDATE=openai:gpt-5
# REIFY_LLM_INTENT=openai:gpt-5-nano

# Anthropic
# ANTHROPIC_API_KEY=...
# REIFY_LLM_RECONSOLIDATE=anthropic:claude-sonnet-4

# Ollama (local)
# OLLAMA_BASE_URL=http://localhost:11434
# REIFY_LLM_EXTRACT=ollama:llama3.2:3b

# Embedder (default: fastembed local)
# REIFY_EMBED_MODEL=BAAI/bge-small-en-v1.5

# Reranker (default: fastembed local)
# REIFY_RERANK_MODEL=BAAI/bge-reranker-base

# Server
# REIFY_HTTP_HOST=127.0.0.1
# REIFY_HTTP_PORT=7878

# Logging
# REIFY_LOG_LEVEL=INFO

# PII Redaction (deterministic regex-based)
# REIFY_PII_REDACT=on
